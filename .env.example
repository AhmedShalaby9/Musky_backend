# Set these environment variables in your terminal or deployment configuration.
# The application intentionally does not automatically load .env files.
MYSQL_DSN=musky:REPLACE_WITH_DATABASE_PASSWORD@tcp(127.0.0.1:3306)/musky?parseTime=true
MUSKY_ADDR=127.0.0.1:8080
GIN_MODE=release

# Only needed for go run ./cmd/bootstrap. No default account is seeded.
BOOTSTRAP_NAME=System Owner
BOOTSTRAP_EMAIL=superadmin@musky.com
BOOTSTRAP_PASSWORD=SuperAdmin@2020

# Optional: fresh, dedicated test database. Never point at business data.
# MYSQL_TEST_DSN=musky_test:REPLACE_WITH_TEST_PASSWORD@tcp(127.0.0.1:3306)/musky_test
