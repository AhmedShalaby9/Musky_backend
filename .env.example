# Set these environment variables in your terminal or deployment configuration.
# The application intentionally does not automatically load .env files.
MYSQL_DSN=musky:REPLACE_WITH_DATABASE_PASSWORD@tcp(127.0.0.1:3306)/musky?parseTime=true
MUSKY_ADDR=127.0.0.1:8080
GIN_MODE=release

# Path to a Chrome/Chromium binary, used headless to render invoice PDFs
# (see docs/pdf-rendering-migration.md). Optional: without it, chromedp
# falls back to searching common install locations, which is normally
# enough on a developer's machine but should be set explicitly in
# production. If Chromium can't be found/started, the server still starts;
# only POST /invoices/:id/pdf requests fail (503) until this is fixed.
# MUSKY_CHROME_PATH=/usr/bin/chromium

# Only set to 1 if the server process runs Chrome as root (e.g. a root
# systemd unit) and switching to a dedicated non-root user isn't an
# option — Chrome refuses to launch as root otherwise. Prefer a non-root
# user instead of this; it removes a real security boundary.
# MUSKY_CHROME_NO_SANDBOX=1

# Only needed for go run ./cmd/bootstrap. No default account is seeded.
BOOTSTRAP_NAME=System Owner
BOOTSTRAP_EMAIL=superadmin@musky.com
BOOTSTRAP_PASSWORD=SuperAdmin@2020

# Optional: fresh, dedicated test database. Never point at business data.
# MYSQL_TEST_DSN=musky_test:REPLACE_WITH_TEST_PASSWORD@tcp(127.0.0.1:3306)/musky_test
